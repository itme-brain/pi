  "terminal": {
    "showTerminalProgress": false
  },
  "enabledModels": [
    "radiance/*"
  ],
  "extensions": [
    "-builtin:llama.cpp"
  ],
  "defaultProvider": "radiance",
  "defaultModel": "Qwen3.8-Flash-Next"
}
