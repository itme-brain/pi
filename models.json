{
  "providers": {
    "llamacpp": {
      "baseUrl": "https://ai.ramos.codes/v1",
      "api": "openai-completions",
      "apiKey": "$LLAMACPP_API_KEY",
      "compat": {
        "supportsReasoningEffort": true,
        "thinkingFormat": "openai"
      },
      "models": [
        {
          "id": "local",
          "name": "ai.ramos.codes",
          "contextWindow": 262144,
          "maxTokens": 32768,
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "xhigh",
            "xhigh": null,
            "max": null
          }
        }
      ]
    }
  }
}
